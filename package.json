{
  "name": "dsh-plugin-voiceinputwithpress",
  "version": "0.1.10",
  "description": "Hold the DSH microphone to dictate and send, with reply readout",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "src/client.js", "src/visual.js", "src/readout-client.js", "src/readout-indicator.js", "src/readout-text.js", "src/tts-host.js", "scripts/tts-worker.py", "scripts/tts_english.py", "scripts/tts-requirements.txt", "cordis.patch.yml", "locale", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": { "build": "node scripts/build.js", "test": "node --test --test-isolation=none test/*.test.js" },
  "repository": { "type": "git", "url": "git+https://github.com/rapidrabbitsliu/dsh-plugin-voiceinputwithpress.git" },
  "homepage": "https://github.com/rapidrabbitsliu/dsh-plugin-voiceinputwithpress#readme",
  "bugs": { "url": "https://github.com/rapidrabbitsliu/dsh-plugin-voiceinputwithpress/issues" },
  "keywords": ["dsh", "deepseek-harness", "voice-input", "press-to-talk"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "license": "MIT"
}
